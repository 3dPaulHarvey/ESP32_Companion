{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esp32-companion-control",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "send_metrics": false,
  "preview_urls": false,
  "secrets": {
    "required": ["DEVICE_AUTH_TOKEN"]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_RATE_LIMITER",
        "class_name": "DeviceRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "device-rate-sqlite-v1",
      "new_sqlite_classes": ["DeviceRateLimiter"]
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
