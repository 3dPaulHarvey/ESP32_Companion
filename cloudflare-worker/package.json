{
  "name": "esp32-companion-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Gemini session service for the ESP32 companion",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "node --test",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "login": "wrangler login --use-keyring --scopes account:read user:read workers_scripts:write",
    "whoami": "wrangler whoami",
    "deploy": "wrangler deploy",
    "session-check": "node ../tools/check_gemini_session.mjs --connect",
    "voice-check": "node ../tools/check_gemini_session.mjs --speak",
    "audio-fixture": "python ../tools/make_audio_fixture.py",
    "audio-check": "node ../tools/check_gemini_session.mjs --audio-question",
    "test-desktop": "node --test ../tools/test_gemini_audio.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261117.0-beta",
    "wrangler": "4.164.0"
  },
  "allowScripts": {
    "workerd@1.20261117.1": true,
    "esbuild@0.28.2": true
  }
}
