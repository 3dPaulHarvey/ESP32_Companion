# Supplied Seeed XIAO ESP32-S3 hardware, probed on COM26 on 2026-11-09.
# Load after sdkconfig.defaults and sdkconfig.defaults.esp32s3.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_TYPE_SEEEDSTUDIO_S3_WIFI=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/8m.csv"
CONFIG_OLED_SSD1306_128X64=y
CONFIG_USE_AFE_WAKE_WORD=y
CONFIG_FLASH_DEFAULT_ASSETS=y
# Built-in English wake phrase: "Hi, ESP" (say the letters E-S-P).
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
CONFIG_SR_WN_WN9_HIESP=y
