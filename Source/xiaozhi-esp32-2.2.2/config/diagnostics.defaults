CONFIG_COMPANION_HARDWARE_DIAGNOSTICS=y
# COM26 uses native USB Serial/JTAG; the baseline secondary console is output-only.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USE_AUDIO_DEBUGGER=n
CONFIG_USE_ACOUSTIC_WIFI_PROVISIONING=n
