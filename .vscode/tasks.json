{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Companion: build baseline",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/idf.ps1", "-Action", "build"],
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Companion: flash COM26",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/idf.ps1", "-Action", "flash", "-Port", "COM26"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Companion: monitor COM26",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/idf.ps1", "-Action", "monitor", "-Port", "COM26"],
            "problemMatcher": []
        }
    ]
}
